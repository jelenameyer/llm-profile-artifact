# ----------------------------------------------------------------------------
# Data -- never committed to git.
#   analysis/data/    cleaned 'data' tier, fetched from OSF by download_data.py
#   analysis/source/  raw responses, available on request (not on OSF)
# ----------------------------------------------------------------------------
analysis/data/*
!analysis/data/.gitkeep
analysis/source/*
!analysis/source/.gitkeep
*.zip

# ----------------------------------------------------------------------------
# Generated results -- reproduced by running the pipeline, not version-tracked.
# Remove these two rules if you DO want to ship the figures/tables in the repo.
# ----------------------------------------------------------------------------
analysis/results/figures/*
!analysis/results/figures/.gitkeep
analysis/results/tables/*
!analysis/results/tables/.gitkeep

# Raw LLM generation outputs (large; regenerated by data_generation/)
# Covers outputs_api/ plus the per-session dirs for the self-hosted vLLM runs
# (outputs_api_large/, outputs_api_large_rep2/, ...). These belong in the source
# data tier that is shared on request, not in the repo.
data_generation/**/outputs_api*/
# Large per-participant human-derived prompts (live on OSF, not git).
# NB: the small task-definition jsonls under direct/tasks/jsonl_data/ ARE committed
# (the analysis reads ipipneo300_items.jsonl and lot_prompts.jsonl from there).
data_generation/hybrid/survey_data/

# ----------------------------------------------------------------------------
# Secrets -- API keys for data_generation must never be committed.
# ----------------------------------------------------------------------------
.env
*.env
secrets.json
credentials.json

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
ENV/
env/
.ipynb_checkpoints/

# ----------------------------------------------------------------------------
# OS / editor
# ----------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# R history
.Rhistory



# ----------------------------------------------------------------------------
# documentation and AI help files
# ----------------------------------------------------------------------------
Claude.md
vllm_models.txt
probe_thinking.py
VLLM_RUN_NOTES.md
endpoints.env.example
run_parallel_large.sh
wait_for_endpoints.py