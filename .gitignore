# ----------------------------------------------------------------------------
# Data -- never committed to git.
#   analysis/data/    cleaned 'data' tier, fetched from OSF by download_data.py
#   analysis/source/  raw responses, 'source' tier on OSF
# ----------------------------------------------------------------------------
analysis/data/*
!analysis/data/.gitkeep
analysis/source/*
!analysis/source/.gitkeep
*.zip

# ----------------------------------------------------------------------------
# Generated results -- reproduced by running the pipeline.
# ----------------------------------------------------------------------------
analysis/results/figures/*
!analysis/results/figures/.gitkeep
analysis/results/tables/*
!analysis/results/tables/.gitkeep
data_generation/**/outputs_api*/
data_generation/hybrid/survey_data/

# ----------------------------------------------------------------------------
# Secrets -- API keys for data_generation.
# ----------------------------------------------------------------------------
.env
*.env
secrets.json
credentials.json

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
ENV/
env/
.ipynb_checkpoints/

# ----------------------------------------------------------------------------
# OS / editor
# ----------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# R history
.Rhistory



# ----------------------------------------------------------------------------
# documentation and AI help files
# ----------------------------------------------------------------------------
Claude.md
CLAUDE.md
vllm_models.txt
probe_thinking.py
repeat_determinism.py
VLLM_RUN_NOTES.md
endpoints.env.example
run_parallel_large.sh
wait_for_endpoints.py
run_logs/
